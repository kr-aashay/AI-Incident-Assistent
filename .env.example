# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:PLACEHOLDER@localhost:5432/incidents
# WEBHOOK_TOKEN (minimum 16 characters). Generate with: openssl rand -hex 24
WEBHOOK_TOKEN=generate_with_openssl_rand_hex_24_minimum_16_chars

# ── AI (degrades gracefully if unset) ────────────────────────────────────────
ANTHROPIC_API_KEY=PLACEHOLDER
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Slack (optional – message is logged if unset) ─────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PLACEHOLDER/PLACEHOLDER/PLACEHOLDER

# ── Kubernetes / Prometheus ───────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
ENABLE_K8S_COLLECTION=true

# ── Tuning ────────────────────────────────────────────────────────────────────
LOG_TAIL_LINES=100
MAX_LOG_CHARS=6000
LLM_TIMEOUT_SECONDS=30

# ── Port reference (informational only, not read by app settings) ──────────────
# APP_PORT=8000
# DEMO_APP_PORT=8001
# POSTGRES_PORT=5432
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
